# Copy this file to .env and add your TypeSafe API key.
# Never commit your real .env file.

TYPESAFE_API_KEY=

# Documented defaults. Override only if TypeSafe changes the API or you use a custom gateway.
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_AUTH_HEADER=Authorization
TYPESAFE_API_AUTH_PREFIX=Bearer
